# ============================================================
# 自動投稿システム設定サンプル
#   1. このファイルを .env にコピーする
#   2. 各値を自分のものに置き換える
#   .env は .gitignore 済み。秘密情報をコミットしないこと。
# ============================================================

# ---------- TikTok（TikTok for Developers で取得） ----------
# https://developers.tiktok.com/ → Manage apps → 対象アプリ
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Login Kit (Desktop) のリダイレクトURI。
# TikTok開発者ポータルにこの値をそのまま登録すること（末尾スラッシュまで一致が必要）。
# 認証は OAuth 2.0 + PKCE(S256) で行い、このURIをローカルHTTPサーバが受け取る。
TIKTOK_REDIRECT_URI=http://127.0.0.1:3455/callback/

# ---------- Threads（本命1・完全自動投稿） ----------
# https://developers.facebook.com/apps/ で「Threads」アプリを作成して取得する
# 必要スコープ: threads_basic, threads_content_publish, threads_manage_insights
THREADS_APP_ID=
THREADS_APP_SECRET=
# アプリに登録した「有効なOAuthリダイレクトURI」と完全一致させる（HTTPS必須）
# 例: Cloudflare Pages のURLをそのまま使う
THREADS_REDIRECT_URI=https://honeshinri-media.pages.dev/
# 投稿先のThreadsユーザーID（数値。@ユーザー名ではない）
# 空のままで構いません。connect threads の時に自動取得して使います。
# 複数アカウントを使い分けるなど、固定したい場合だけ記入してください。
THREADS_USER_ID=
# APIホスト（graph.threads.net / graph.threads.com のどちらでも動作する）
THREADS_API_HOST=https://graph.threads.net
THREADS_API_VERSION=v1.0

# ---------- Pinterest（https://developers.pinterest.com/apps/ で取得） ----------
# 最初の完全自動チャネル。Pin作成に必要なスコープは
#   boards:read, boards:write, pins:read, pins:write（+ user_accounts:read）
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# アプリに登録したリダイレクトURIと完全一致させる。
#   ループバックを登録できる場合はこのまま（ローカルサーバが受け取る）
#   HTTPSしか登録できない場合は登録した値を入れ、`connect pinterest --manual` を使う
PINTEREST_REDIRECT_URI=http://localhost:8730/callback/
# 投稿先ボードのID（`python autopost.py pinterest boards` で確認できる）
PINTEREST_BOARD_ID=
# Pinのリンク先（未指定ならリンクなしのPinになる）
PINTEREST_DEFAULT_LINK=
# true にすると api-sandbox.pinterest.com を使う（実際には公開されない検証用）
PINTEREST_SANDBOX=false

# ---------- Meta / Instagram（Meta for Developers で取得） ----------
# https://developers.facebook.com/ → マイアプリ → 対象アプリ
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8720/callback/meta
# 投稿先 Instagram プロアカウント（ビジネス/クリエイター）のID
INSTAGRAM_ACCOUNT_ID=
# Graph API のバージョン（未指定なら既定値を使用）
META_GRAPH_VERSION=v21.0
# ログイン方式:
#   instagram … Instagram Login（Instagramアカウントで直接認可。長期トークン自動更新あり）
#   facebook  … Facebook Login for Business（Facebookページ連携。60日ごとに再認証が必要）
META_LOGIN_MODE=instagram

# ---------- 画像ホスティング ----------
# TikTokの写真投稿は「公開HTTPS URL（所有権を検証したドメイン）」が必須。
# Instagramも公開HTTPS URLが必要。両方で同じURLを使い回す。
#   IMAGE_HOST=pages  … Cloudflare Pages のローカルディレクトリへコピー（デプロイで公開）
#   IMAGE_HOST=r2     … Cloudflare R2（S3互換。boto3が必要）
#   IMAGE_HOST=local  … 自前の公開ディレクトリへコピー（別途Webサーバで配信）
#   IMAGE_HOST=none   … 未設定（公開済みURLを直接指定する運用なら none のままでよい）
IMAGE_HOST=none

# --- IMAGE_HOST=r2 の場合 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 公開URLの先頭（カスタムドメイン推奨。TikTokの所有権検証はこのドメインに対して行う）
R2_PUBLIC_BASE_URL=https://media.example.com/honne

# --- IMAGE_HOST=local / pages の場合 ---
# 画像をコピーするローカルディレクトリ（Cloudflare Pagesのプロジェクトフォルダなど）
LOCAL_HOST_DIR=
# そのディレクトリが公開されるURLの先頭（例: https://honeshinri-media.pages.dev）
LOCAL_HOST_BASE_URL=https://media.example.com/honne

# ---------- 自動補充（実験ループを止めないための設定） ----------
# 配信待ちが AUTO_TOPUP_MIN を下回ったら、AUTO_TOPUP_COUNT 件を自動生成して予約する
AUTO_TOPUP=true
AUTO_TOPUP_MIN=10
AUTO_TOPUP_COUNT=30
# 画像を公開するコマンド。設定すると補充時に自動でデプロイまで行う
# 例: npx wrangler pages deploy pages_media --project-name honeshinri-media
PAGES_DEPLOY_COMMAND=

# ---------- 配信ペース ----------
# 1日に配信する件数。API上限（Threads 250 / Instagram 100）より十分低い安全側の値。
THREADS_DAILY_LIMIT=10
INSTAGRAM_DAILY_LIMIT=5

# ---------- 投稿動作 ----------
# 予約投稿のタイムゾーン
TIMEZONE=Asia/Tokyo
# TikTokの公開範囲: PUBLIC_TO_EVERYONE / MUTUAL_FOLLOW_FRIENDS / FOLLOWER_OF_CREATOR / SELF_ONLY
# ※ 審査未通過(unaudited)のクライアントは自動的に SELF_ONLY 相当になる
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# 写真投稿に音楽を自動付与（TikTok公式APIの auto_add_music）
TIKTOK_AUTO_ADD_MUSIC=true
# TikTokの投稿方式（公式に許可された方法のみ）
#   direct_post … Direct Postを試し、使えなければ自動で下書き転送へ切り替える
#   upload      … 最初から下書き（インボックス）へ転送する。公開は手動
#   queue_only  … 送信せずQueueに保持するだけ
TIKTOK_MODE=direct_post
# 期限切れ投稿の扱い: single（1件だけ投稿し残りは再スケジュール） / all（全部投稿） / skip（全部スキップ）
CATCHUP_POLICY=single
# 予約時刻から何分過ぎたら「期限切れ」とみなすか
CATCHUP_GRACE_MINUTES=120
# 両方のプラットフォームで成功した投稿フォルダを posted/ へ移動するか
MOVE_AFTER_PUBLISH=false

# ---- Instagram Reel（縦動画・手動投稿）----
# Reelは自動投稿しません。音源はInstagramアプリでご自分で付けてください。
REEL_SECONDS_QUESTION=3.0
REEL_SECONDS_ANSWER=2.5
INSTAGRAM_REEL_DAILY_LIMIT=3
REEL_OUTPUT_DIR=reels_ready
